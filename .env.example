# x402 Bazaar API
X402_SERVER_URL=https://x402-api.onrender.com

# Agent Wallet (Base mainnet, pays for x402 API calls)
AGENT_PRIVATE_KEY=0x...your_private_key_here

# Budget limit in USDC
MAX_BUDGET_USDC=0.50

# Telegram (admin preview + approval)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_admin_chat_id

# Telegram Public Channel (auto-post)
TELEGRAM_CHANNEL_ID=@your_channel_name

# Discord (auto-post via webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Dev.to (optional — free API key from https://dev.to/settings/extensions)
DEVTO_API_KEY=

# Reddit (optional — needs OAuth2 app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# LinkedIn (optional — OAuth2 access token)
LINKEDIN_ACCESS_TOKEN=

# Twitter (optional — requires $100/month Basic tier)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Farcaster (optional — signer key via Neynar or direct Hub)
FARCASTER_SIGNER_KEY=0x...your_signer_key_here
FARCASTER_FID=your_farcaster_fid
NEYNAR_API_KEY=your_neynar_api_key

# Google Gemini (primary AI — replaces OpenAI)
# Run: node setup-google-auth.js to get the refresh token
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

# Content settings
DEFAULT_LANGUAGE=en
GENERATE_IMAGES=true

# Dashboard port (default: 3500)
DASHBOARD_PORT=3500

# Timezone offset in hours (e.g. 2 for UTC+2). Defaults to server local time.
# TZ_OFFSET=2
